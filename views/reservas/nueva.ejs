<section class="tarjeta-principal">
    <p class="etiqueta">NUEVO INGRESO</p>
    <hr>
    <h1><%= titulo %></h1>
    <% if (error) { %>
        <p class="error-msg" role="alert"><%= error %></p>
    <% } %>
    <form action="/reservas" method="post" class="formulario">
        <label for="estudiante">Estudiante</label>
        <input id="estudiante" name="estudiante" value="<%= valores.estudiante ?? '' %>">
        
        <label for="email">Email</label>
        <input id="email" name="email" value="<%= valores.email ?? '' %>" required>

        <label for="sala">Sala</label>
        <select id="sala" name="sala" required>
            <option value="">Seleccionar sala</option>
            <option value="Sala Norte" <%= valores.sala === 'Sala Norte' ? 'selected' : '' %>>Sala Norte</option>
            <option value="Sala Sur" <%= valores.sala === 'Sala Sur' ? 'selected' : '' %>>Sala Sur</option>
            <option value="Sala Multimedia" <%= valores.sala === 'Adoptada' ? 'selected' : '' %>>Sala Multimedia</option>
        </select>

        <label for="fecha">Fecha</label>
        <input type="date" id="fecha" name="fecha" value="<%= valores.fecha ?? '' %>" required>
      
        <label for="turno">Turno</label>
        <select id="turno" name="turno" required>
            <option value="">Seleccione un turno</option>
            <option value="Mañana" <%= valores.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
            <option value="Tarde" <%= valores.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
            <option value="Noche" <%= valores.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
        </select>

        <label for="personas">Cantidad de personas</label>
        <input id="personas" name="personas" type="number" min="1" max="6" step="1" value="<%= valores.personas ?? '' %>" required>
        <hr>
        <button type="submit">Guardar reserva</button>
    </form>
</section>

<script>
    const formulario = document.querySelector(".formulario");

    const campos = formulario.querySelectorAll("input, select");

    campos.forEach(campo => {

        campo.addEventListener("invalid", function () {
            campo.classList.add("campo-error");
        });

        campo.addEventListener("input", function () {
            if (campo.checkValidity()) {
                campo.classList.remove("campo-error");
            }
        });

        campo.addEventListener("change", function () {
            if (campo.checkValidity()) {
                campo.classList.remove("campo-error");
            }
        });

    });
</script>